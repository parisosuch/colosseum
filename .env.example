# Local development defaults — see README "Local development".
#
# Copy this file to `.env.local` to get started:  cp .env.example .env.local

# Direct Postgres connection for Drizzle (data access + migrations). Points at
# the compose `db` service's loopback port mapping (`bun run db:start`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Secret Better Auth signs session tokens with. Any value works locally;
# generate a real one for production:  openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me

# Public URL Better Auth validates sign-in/sign-up requests' Origin against.
# Defaults to http://localhost:3000. Set this to your real domain when
# deploying behind one (e.g. https://colosseum.example.com), or auth requests
# get a 403 "Invalid origin".
# BETTER_AUTH_URL=http://localhost:3000

# Root directory for content-addressed blob storage (uploaded images,
# screenshots). Files land at <STORAGE_DIR>/<sha[0:2]>/<sha256>.
# STORAGE_DIR=./data/storage

# Set to "true" to close new account registration. Enforced both in the
# sign-up UI and server-side in the auth sign-up hook, and server-side only,
# so it can be flipped at runtime without a rebuild. Defaults to open.
# DISABLE_SIGNUPS=false
