# Local development defaults — see README "Local development".
#
# Copy this file to `.env.local` to get started:  cp .env.example .env.local

# Direct Postgres connection for Drizzle (data access + migrations). Points at
# the compose `db` service's loopback port mapping (`bun run db:start`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Secret Better Auth signs session tokens with. Any value works locally;
# generate a real one for production:  openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me

# Public URL Better Auth validates sign-in/sign-up requests' Origin against.
# Defaults to http://localhost:3000. Set this to your real domain when
# deploying behind one (e.g. https://colosseum.example.com), or auth requests
# get a 403 "Invalid origin". Also the origin for the logo in outbound emails,
# so set it to your real domain or the email image won't load.
# BETTER_AUTH_URL=http://localhost:3000

# Root directory for content-addressed blob storage (uploaded images,
# screenshots). Files land at <STORAGE_DIR>/<sha[0:2]>/<sha256>.
# STORAGE_DIR=./data/storage

# GitHub API token for GitHub blocks. Optional: without one, metadata is
# fetched unauthenticated at 60 requests/hour/IP, and a block that gets rate
# limited falls back to a plain screenshot-backed link block. A token (no
# scopes needed — this only reads public repos and profiles) raises the limit
# to 5000/hour.
# GITHUB_TOKEN=

# S3-compatible blob storage (AWS S3, Cloudflare R2, MinIO, …). Optional:
# without S3_BUCKET, blobs stay on local disk (STORAGE_DIR above). Setting
# S3_BUCKET switches every blob operation to the bucket.
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# Bucket base URL. Omit for AWS (derived from bucket + region). Required for
# non-AWS: e.g. https://<account>.r2.cloudflarestorage.com/<bucket>
# S3_ENDPOINT=
# Public CDN/edge base URL in front of the bucket. When set, public media
# redirects straight to the CDN instead of streaming through the app; private
# media always streams. Objects are keyed <sha[0:2]>/<sha>.
# CDN_URL=https://cdn.example.com

# Set to "true" to close new account registration. Enforced both in the
# sign-up UI and server-side in the auth sign-up hook, and server-side only,
# so it can be flipped at runtime without a rebuild. Defaults to open.
# DISABLE_SIGNUPS=false

# Outbound email (password resets, notifications) is configured at runtime in
# the admin panel (Resend or SMTP), not here — see the "Email" section under
# /admin.

# REST API rate limit (per token owner). Each /api/v1/* request counts against a
# fixed window; over the cap returns 429 with Retry-After. Read at request time,
# so both can be retuned without a rebuild. Defaults: 100 requests / 60s.
# Set API_RATE_LIMIT=0 to disable rate limiting entirely.
# API_RATE_LIMIT=100
# API_RATE_WINDOW_MS=60000

# Redis cache for hot, stable read queries (channel metadata and the per-user
# channel lists). In the Docker stack this is ON by default, pointing at the
# bundled `redis` service (see compose.yaml). Caching only activates when
# REDIS_URL is set, so for local dev (this file) it stays OFF unless you point
# it at a Redis — with none, the app queries Postgres directly. Redis failures
# always fall back to Postgres, so the cache can never take the app down.
# REDIS_URL=redis://localhost:6379
# Set to "false" to turn caching off even when REDIS_URL is set.
# REDIS_CACHE_ENABLED=true

# ffmpeg, used to decode the poster frame a video block's card shows instead of
# fetching the video itself. Only set this when the binary isn't on PATH under
# its own name. Optional: with no ffmpeg, video blocks still upload and play,
# and their cards fall back to a placeholder.
# FFMPEG_PATH=/usr/bin/ffmpeg
