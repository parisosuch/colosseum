# Local Supabase (Docker) — see README "Local development".
#
# These are the Supabase CLI's fixed default local credentials. They are NOT
# secret (every local stack uses them) so they're committed for easy onboarding.
# After `bun run db:start`, run `bun run db:status` and copy the values it prints
# in case your CLI version emits different keys.
#
# Copy this file to `.env.local` to get started:  cp .env.example .env.local

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# anon / publishable key (browser + middleware, RLS-gated)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# service_role key (server-side, bypasses RLS) — keep out of the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres connection for Drizzle (data access + migrations). This is the
# local Supabase database's fixed default connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Root directory for content-addressed blob storage (uploaded images,
# screenshots). Files land at <STORAGE_DIR>/<sha[0:2]>/<sha256>.
# STORAGE_DIR=./data/storage

# Set to "true" to close new account registration (the /auth/sign-up page shows
# a "sign-ups are closed" message and sign-up links are hidden). Server-side
# only, so it can be flipped at runtime without a rebuild. Defaults to open.
#
# This gates the app UI only. For an authoritative block (sign-up is a direct
# browser -> Supabase Auth call), also disable signups in Supabase:
#   - local / self-hosted CLI: set `enable_signup = false` in supabase/config.toml
#   - self-hosted Docker:      set GOTRUE_DISABLE_SIGNUP=true on the auth service
#   - hosted Supabase:         Authentication -> Providers -> Email -> disable signups
# DISABLE_SIGNUPS=false
