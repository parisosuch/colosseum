{
  "name": "colosseum",
  "version": "1.12.1",
  "private": true,
  "description": "A self-hostable, Are.na-style tool for collecting and organizing the web into channels of blocks.",
  "homepage": "https://github.com/parisosuch/colosseum#readme",
  "bugs": {
    "url": "https://github.com/parisosuch/colosseum/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parisosuch/colosseum.git"
  },
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose --env-file .env.local up -d --wait db",
    "db:stop": "docker compose --env-file .env.local stop db",
    "db:status": "docker compose --env-file .env.local ps db",
    "db:reset": "docker compose --env-file .env.local down -v && docker compose --env-file .env.local up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:seed": "bun --conditions=react-server scripts/seed.ts",
    "data:migrate": "bun --conditions=react-server scripts/run-data-migrations.ts",
    "export-blobs": "bun --conditions=react-server scripts/export-blobs.ts",
    "test": "bun test --conditions=react-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.10",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "global-tld-list": "^1.22.45",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.511.0",
    "mcp-handler": "^1.1.0",
    "next": "^15.5.16",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "puppeteer": "^24.24.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-tweet": "^3.3.1",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tldts": "^7.0.17",
    "vaul": "^1.1.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.19.21",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  }
}
